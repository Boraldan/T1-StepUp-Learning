<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <include resource="org/springframework/boot/logging/logback/base.xml"/>

    <appender name="ASPECT_FILE" class="ch.qos.logback.core.FileAppender">
        <file>logs/logsAOP.log</file>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>

    <logger name="ru.boraldan.logaopstarter.starter.aspect.LogAspect" additivity="false">
        <appender-ref ref="ASPECT_FILE"/>
    </logger>

</configuration>